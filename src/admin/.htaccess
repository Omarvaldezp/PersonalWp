# Panel de administración (Supabase)
#
# /admin/ abre el panel del blog, que es el único que queda. El panel PHP se
# retiró en octubre de 2026; cualquier enlace o marcador viejo a un .php de
# esta carpeta (index.php, login.php, estudiantes/..., etc.) se manda al panel.
DirectoryIndex index.html

RedirectMatch 301 ^/admin/.*\.php$ /admin/

# Prevent directory listing
Options -Indexes

# Force HTTPS (if available)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Igual que en la raíz: las reglas de mod_rewrite de la raíz no se heredan
    # aquí, porque este .htaccess tiene su propio RewriteEngine. Además así la
    # sesión del panel (localStorage) vive siempre en un solo dominio.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>
