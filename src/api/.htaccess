# API PHP retirada (octubre de 2026)
#
# El panel y la API PHP se eliminaron: todo el sitio trabaja con Supabase.
# Este archivo se queda a propósito para cerrar /api/ por completo.
#
# Por qué no basta con borrar los archivos: el deploy solo elimina del
# servidor lo que alguna vez estuvo en el repo. config/config.php, con las
# credenciales de la base PostgreSQL, nunca estuvo en git y sigue en
# /public_html/api/config/ hasta que se borre a mano desde SiteGround. Mientras
# exista, este bloqueo impide alcanzarlo por HTTP.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
