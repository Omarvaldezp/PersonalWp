# API - Configuración de acceso
#
# Deliberadamente SIN reglas de mod_rewrite.
#
# La versión anterior de este archivo traía un RewriteEngine con redirección a
# HTTPS y un bloqueo por RewriteRule, y con ella /api/auth/login.php empezó a
# responder 404, con lo que el panel dejó de poder cerrar sesión. La
# redirección a HTTPS ya la hace el .htaccess de la raíz, así que aquí sobra.
#
# El bloqueo de los directorios internos se hace ahora con un .htaccess propio
# dentro de cada uno (config/, models/, utils/), que no puede afectar a las
# rutas vecinas.
#
# Por HTTP solo deben alcanzarse:
#   - controllers/*.php   endpoints del panel y del formulario público
#   - auth/login.php      login, logout y consulta del usuario actual

Options -Indexes

<FilesMatch "\.(sql|md|ini|log|bak)$|\.example\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
